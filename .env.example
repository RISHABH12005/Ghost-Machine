# GitHub OAuth App credentials. Register callback: https://YOUR-DOMAIN/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Required: generate with: openssl rand -base64 32
# Used to encrypt the HttpOnly GitHub session cookie.
AUTH_SECRET=

# Optional local Ollama endpoint for AI analysis.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
DATABASE_URL=
