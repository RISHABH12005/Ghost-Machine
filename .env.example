# GitHub OAuth App credentials. Register callback: https://YOUR-DOMAIN/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Required: generate with: openssl rand -base64 32
# Used to encrypt the HttpOnly GitHub session cookie.
AUTH_SECRET=

# Ollama Cloud API. Create a key at https://ollama.com/settings/keys.
# The key is used only by server-side API routes and must never be exposed to the browser.
OLLAMA_API_KEY=
# Optional. Defaults to glm-5.3.
OLLAMA_MODEL=glm-5.3
DATABASE_URL=
